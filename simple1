blueprint:
  name: "Philips Hue Dimmer V2 - Power Toggle Only"
  description: "Focused on making the Top Power button a reliable toggle."
  domain: automation
  input:
    remote:
      name: Dimmer Switch
      selector:
        device:
          integration: zha
          model: RWL022
    power_button_action:
      name: Power Button Action
      description: "Select 'Light: Toggle' here to switch between on and off."
      default: []
      selector:
        action: {}

mode: restart # Ensures quick consecutive presses are handled correctly

trigger:
  - platform: event
    event_type: zha_event
    event_data:
      device_id: !input remote

action:
  - variables:
      command: "{{ trigger.event.data.command }}"

  - choose:
      # We only care about the 'on' command from the top button
      - conditions:
          - "{{ command == 'on' }}"
        sequence: !input power_button_action
