blueprint:
  name: Philips Hue Dimmer RWL022 (ZHA - Ultimate Fixed)
  description: "Advanced Dimming & Scene Cycling for V2 Hue Dimmer."
  domain: automation
  input:
    remote:
      name: Dimmer Switch
      selector:
        device:
          integration: zha
          model: RWL022
    light_target:
      name: Light(s)
      selector:
        target:
          entity:
            domain: light
    scenes_to_cycle:
      name: Scenes to Cycle
      default: []
      selector:
        entity:
          domain: scene
          multiple: true
    button_on_press:
      name: "Top Button Action"
      default: []
      selector:
        action: {}
    dim_step_pct:
      name: "Step Percentage"
      default: 10
      selector:
        number:
          min: 1
          max: 50
          unit_of_measurement: "%"
    dim_transition:
      name: "Transition Speed"
      default: 0.5
      selector:
        number:
          min: 0.1
          max: 2.0
          step: 0.1
          unit_of_measurement: "s"

mode: restart

trigger:
  - platform: event
    event_type: zha_event
    event_data:
      device_id: !input remote

action:
  - variables:
      command: "{{ trigger.event.data.command }}"
      args: "{{ trigger.event.data.args }}"
      scenes: !input scenes_to_cycle
      step_pct: !input dim_step_pct
      transition: !input dim_transition

  - choose:
      # 1. POWER TOGGLE
      - conditions:
          - or:
              - "{{ command == 'on' }}"
              - "{{ command == 'off_with_effect' }}"
        sequence: !input button_on_press

      # 2. DIM UP (Short & Long)
      - conditions:
          - "{{ command == 'step' and args[0] == 0 }}"
        sequence:
          - service: light.turn_on
            target: !input light_target
            data:
              brightness_step_pct: "{{ step_pct }}"
      - conditions:
          - "{{ command == 'move' and args[0] == 0 }}"
        sequence:
          - repeat:
              while:
                - condition: template
                  value_template: "{{ wait.trigger == none }}"
              sequence:
                - service: light.turn_on
                  target: !input light_target
                  data:
                    brightness_step_pct: "{{ step_pct }}"
                    transition: "{{ transition }}"
                - wait_for_trigger:
                    - platform: event
                      event_type: zha_event
                      event_data:
                        device_id: !input remote
                        command: stop
                  timeout: "00:00:01"

      # 3. DIM DOWN (Short & Long)
      - conditions:
          - "{{ command == 'step' and args[0] == 1 }}"
        sequence:
          - service: light.turn_on
            target: !input light_target
            data:
              brightness_step_pct: "{{ step_pct * -1 }}"
      - conditions:
          - "{{ command == 'move' and args[0] == 1 }}"
        sequence:
          - repeat:
              while:
                - condition: template
                  value_template: "{{ wait.trigger == none }}"
              sequence:
                - service: light.turn_on
                  target: !input light_target
                  data:
                    brightness_step_pct: "{{ step_pct * -1 }}"
                    transition: "{{ transition }}"
                - wait_for_trigger:
                    - platform: event
                      event_type: zha_event
                      event_data:
                        device_id: !input remote
                        command: stop
                  timeout: "00:00:01"

      # 4. HUE BUTTON (Scene Cycle)
      - conditions:
          - or:
              - "{{ command == 'recall' }}"
              - "{{ command == 'on_with_recall' }}"
        sequence:
          - service: scene.turn_on
            target:
              entity_id: >
                {% set total = scenes | length %}
                {% if total > 0 %}
                  {# Use a global variable to track index if possible, otherwise cycle by time #}
                  {% set last_idx = states('input_number.hue_dimmer_scene_index') | int(default=-1) %}
                  {% set next_idx = (last_idx + 1) % total %}
                  {{ scenes[next_idx] }}
                {% endif %}
          {# Attempting to store the index in a temporary variable if it exists, otherwise it just cycles from start #}
          - if:
              - condition: template
                value_template: "{{ states('input_number.hue_dimmer_scene_index') != 'unknown' }}"
            then:
              - service: input_number.set_value
                target:
                  entity_id: input_number.hue_dimmer_scene_index
                data:
                  value: >
                    {% set last_idx = states('input_number.hue_dimmer_scene_index') | int(default=-1) %}
                    {{ (last_idx + 1) % (scenes | length) }}
