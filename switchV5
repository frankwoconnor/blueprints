blueprint:
  name: Philips Hue Dimmer RWL022 (ZHA - Essential)
  description: "Verified logic for Power Toggle, Dimming, and Scene Cycle."
  domain: automation
  input:
    remote:
      name: Dimmer Switch
      selector:
        device:
          integration: zha
          model: RWL022
    light_target:
      name: Light(s)
      selector:
        target:
          entity:
            domain: light
    button_on_press:
      name: "Top Button Action (Power)"
      default: []
      selector:
        action: {}
    scene_1:
      name: "Hue Button - Scene 1"
      default: []
      selector:
        action: {}
    scene_2:
      name: "Hue Button - Scene 2"
      default: []
      selector:
        action: {}

mode: restart

trigger:
  - platform: event
    event_type: zha_event
    event_data:
      device_id: !input remote

action:
  - variables:
      command: "{{ trigger.event.data.command }}"
      args: "{{ trigger.event.data.args }}"

  - choose:
      # 1. TOP BUTTON (Power Toggle)
      - conditions:
          - "{{ command == 'on' or command == 'off_with_effect' }}"
        sequence: !input button_on_press

      # 2. DIM UP (Upper Middle)
      - conditions:
          - "{{ command == 'step' and args[0] == 0 }}"
        sequence:
          - service: light.turn_on
            target: !input light_target
            data:
              brightness_step_pct: 10

      # 3. DIM DOWN (Lower Middle)
      - conditions:
          - "{{ command == 'step' and args[0] == 1 }}"
        sequence:
          - service: light.turn_on
            target: !input light_target
            data:
              brightness_step_pct: -10

      # 4. HUE BUTTON (Bottom)
      # Uses a simple toggle logic: if Scene 1 is active, run Scene 2, else Scene 1.
      - conditions:
          - "{{ command == 'recall' or command == 'on_with_recall' }}"
        sequence:
          - choose:
              - conditions:
                  - condition: template
                    value_template: "{{ is_state('input_boolean.hue_scene_toggle', 'off') }}"
                sequence:
                  - !input scene_1
                  - service: input_boolean.turn_on
                    target:
                      entity_id: input_boolean.hue_scene_toggle
              - conditions:
                  - condition: template
                    value_template: "{{ is_state('input_boolean.hue_scene_toggle', 'on') }}"
                sequence:
                  - !input scene_2
                  - service: input_boolean.turn_off
                    target:
                      entity_id: input_boolean.hue_scene_toggle
