blueprint:
  name: Philips Hue Dimmer RWL022 (ZHA - Area Logic)
  description: "Direct mapping optimized for Area-based scene cycling."
  domain: automation
  input:
    remote:
      name: Dimmer Switch
      selector:
        device:
          integration: zha
          model: RWL022
    target_area:
      name: Target Area
      description: The Area (Room) this remote controls.
      selector:
        area: {}
    button_top:
      name: "1. Top Button (Power Toggle)"
      default: []
      selector:
        action: {}
    # We leave the middle buttons for standard dimming actions

mode: restart

trigger:
  - platform: event
    event_type: zha_event
    event_data:
      device_id: !input remote

action:
  - variables:
      command: "{{ trigger.event.data.command }}"
      args: "{{ trigger.event.data.args }}"
      area: !input target_area

  - choose:
      # 1. TOP BUTTON (Toggle)
      - conditions:
          - "{{ command == 'on' or command == 'off_with_effect' }}"
        sequence: !input button_top

      # 2. DIM UP
      - conditions:
          - "{{ command == 'step' and args[0] == 0 }}"
        sequence:
          - service: light.turn_on
            target:
              area_id: !input target_area
            data:
              brightness_step_pct: 10

      # 3. DIM DOWN
      - conditions:
          - "{{ command == 'step' and args[0] == 1 }}"
        sequence:
          - service: light.turn_on
            target:
              area_id: !input target_area
            data:
              brightness_step_pct: -10

      # 4. BOTTOM BUTTON (The "Hue" Cycle)
      - conditions:
          - "{{ command == 'recall' or command == 'on_with_recall' }}"
        sequence:
          # This is the "Magic" action that cycles scenes for an Area
          - service: scene.activate
            target:
              area_id: !input target_area
            data:
              transition: 1
          - delay: 0.5 # Debounce
